{
  "compilerOptions": {
    "target": "ES2024",
    /* DOM: e2e `page.evaluate` callbacks and init scripts run in the browser */
    "lib": ["ES2024", "DOM"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    /* vite.config.ts imports ./src/constants/sampleManifest.ts with its
     * extension so Vite's native config loader can resolve it without a
     * bundler resolution step. */
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["vitest/config"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
