{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["unicorn", "typescript", "oxc", "vue"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    // Helper functions near usage is preferred
    "unicorn/consistent-function-scoping": "off",
    "no-await-in-loop": "off",
    // Too noisy with TypeScript enums and type narrowing
    "no-shadow": "off",
    // .sort() is fine for local/intermediate arrays
    "unicorn/no-array-sort": "off",
    // Using .reverse()'s result mutates the source array as a side effect; use
    // .toReversed(), or .findLast() to search from the end. A bare in-place
    // `arr.reverse()` statement is still allowed.
    "unicorn/no-array-reverse": "error",
    // Its fix is to mutate the mapped objects, which are often shared
    // constants or props; the arrays mapped here are a few dozen items at most
    "oxc/no-map-spread": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,vue}", "**/*.spec.{ts,vue}", "**/test/**"],
      "plugins": ["unicorn", "typescript", "oxc", "vue", "vitest"]
    }
  ],
  "ignorePatterns": ["dist", "build", "public", "node_modules"],
  "env": {
    "browser": true
  }
}
